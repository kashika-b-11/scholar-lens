# ==============================================================================
# ScholarLens Environment Variables
# Copy this file to .env and fill in your API key(s)
# ==============================================================================

# Google Gemini API Key (Recommended - Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (if using OpenAI provider)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Default LLM Provider (gemini or openai)
LLM_PROVIDER=gemini
